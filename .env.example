# Copy this file to `.env.local` and fill in the values. `.env.local` is gitignored.

# ── Site ────────────────────────────────────────────────────────────────────
# Public URL used for canonical/OpenGraph links.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: shows a "Star on GitHub" link in the footer.
NEXT_PUBLIC_GITHUB_URL=

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# Where waitlist signups are stored. Any PostgreSQL 12+ works (Neon, Railway,
# Render, RDS, self-hosted, local). The table is created automatically.
# Leave empty to use an in-memory store (signups lost on restart — dev only).
# On serverless hosts (Vercel), prefer your provider's *pooled* connection string.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Optional: max connections per server instance (default 3).
# DATABASE_POOL_MAX=3

# ── Waitlist emails (sent from your Gmail account) ─────────────────────────
# 1. Turn on 2-Step Verification for the Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Paste it below (spaces are fine). Never use your normal Gmail password.
SMTP_USER=you@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Optional: also email yourself a note for every new signup.
WAITLIST_NOTIFY_EMAIL=you@gmail.com

# Optional overrides (defaults shown). Use port 587 for STARTTLS providers.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM_NAME=HyperDrive
# Time zone for the signup time in your notification email, e.g. Asia/Kolkata.
# MAIL_TIMEZONE=UTC
